<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée ne part dans la sauvegarde Google ni dans un transfert
     Smart Switch : la base chiffrée serait illisible sans la clé du Keystore,
     qui, elle, ne se transfère jamais. La sauvegarde passe par l'export JSON. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
